{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CN Health CLI JSON Output",
  "oneOf": [
    { "$ref": "#/$defs/search" },
    { "$ref": "#/$defs/init" },
    { "$ref": "#/$defs/doctor" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "search": {
      "type": "object",
      "required": ["schemaVersion", "command", "dataset", "items", "page"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "command": { "type": "string", "minLength": 1 },
        "dataset": {
          "type": "object",
          "required": ["id", "releaseId"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "releaseId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "query": { "type": "object" },
        "items": { "type": "array", "items": { "type": "object" } },
        "page": {
          "type": "object",
          "required": ["returned", "limit", "truncated"],
          "properties": {
            "returned": { "type": "integer", "minimum": 0 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
            "truncated": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "init": {
      "type": "object",
      "required": ["schemaVersion", "command", "profile", "items"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "command": { "const": "init" },
        "profile": { "const": "starter" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["datasetId", "releaseId", "status"],
            "properties": {
              "datasetId": { "type": "string", "minLength": 1 },
              "releaseId": { "type": "string", "minLength": 1 },
              "status": { "enum": ["installed", "already-installed"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "doctor": {
      "type": "object",
      "required": [
        "schemaVersion",
        "command",
        "ok",
        "cliVersion",
        "dataDir",
        "defaultRegistry",
        "checks"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "command": { "const": "doctor" },
        "ok": { "type": "boolean" },
        "cliVersion": { "type": "string", "minLength": 1 },
        "dataDir": { "type": "string", "minLength": 1 },
        "defaultRegistry": { "type": "string", "format": "uri" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "ok"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "ok": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["schemaVersion", "error"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
