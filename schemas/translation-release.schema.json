{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cn-health-data.example/schemas/translation-release.schema.json",
  "title": "Synthea Chinese Translation Release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "releaseId", "language", "syntheaCommit", "profileId",
    "profileHash", "inventoryHash", "catalogHash", "glossaryHash",
    "promptVersion", "builderVersion", "recordCount", "experimental"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": { "type": "string", "pattern": "^[a-z0-9-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}\\.r[1-9][0-9]*$" },
    "language": { "const": "zh-CN" },
    "syntheaCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "profileId": { "type": "string", "minLength": 1 },
    "profileHash": { "$ref": "#/$defs/sha256" },
    "inventoryHash": { "$ref": "#/$defs/sha256" },
    "catalogHash": { "$ref": "#/$defs/sha256" },
    "glossaryHash": { "$ref": "#/$defs/sha256" },
    "promptVersion": { "type": ["string", "null"], "minLength": 1 },
    "builderVersion": { "type": "string", "minLength": 1 },
    "recordCount": { "type": "integer", "minimum": 0 },
    "experimental": { "type": "boolean" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
