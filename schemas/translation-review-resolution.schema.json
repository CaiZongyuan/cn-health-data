{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cn-health-data.example/schemas/translation-review-resolution.schema.json",
  "title": "Synthea Chinese Translation Review Resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "translationId", "sourceSystem", "sourceVersion", "sourceCode",
    "category", "originalDisplayZh", "finalDisplayZh", "decision", "resolvedBy",
    "upstreamIssue", "evidenceUris", "contexts", "notes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "translationId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceSystem": { "type": "string", "minLength": 1 },
    "sourceVersion": { "type": ["string", "null"], "minLength": 1 },
    "sourceCode": { "type": "string", "minLength": 1 },
    "category": {
      "enum": [
        "source-display-variant", "upstream-module-context",
        "confirmed-source-meaning", "terminology-display-correction"
      ]
    },
    "originalDisplayZh": { "type": "string", "minLength": 1 },
    "finalDisplayZh": { "type": "string", "minLength": 1, "pattern": "[\\u3400-\\u9fff]" },
    "decision": { "const": "resolved" },
    "resolvedBy": { "const": "agent-evidence-review" },
    "upstreamIssue": { "type": "boolean" },
    "evidenceUris": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "format": "uri-reference" }
    },
    "contexts": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string", "minLength": 1 }
  }
}
